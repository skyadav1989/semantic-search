##################################
# SEARCH
##################################
# Fastest: semantic
# Keyword only: bm25
# Most complete but slower: hybrid
SEARCH_MODE=semantic

ENABLE_SEMANTIC=true
ENABLE_BM25=false
ENABLE_RRF=false
ENABLE_QUERY_EXPANSION=true
ENABLE_RERANKER=false
ENABLE_BUSINESS_RANKING=true

SEMANTIC_LIMIT=20
BM25_LIMIT=20
FINAL_RESULTS=10

##################################
# EMBEDDING
##################################

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-base

##################################
# QDRANT
##################################
# QDRANT_URL overrides QDRANT_HOST/QDRANT_PORT when set.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=products
